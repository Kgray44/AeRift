{
  "name": "aerift",
  "private": true,
  "workspaces": [
    "packages/app-contract",
    "apps/aerift",
    "packages/ui",
    "packages/gestures"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test \"tests/contracts/*.test.mjs\"",
    "test:ui": "tsc -p packages/ui/tsconfig.json && node --test tests/ui/*.test.mjs && vite build --config tests/ui/vite.config.mts",
    "test:gestures": "tsc -p packages/gestures && node --test tests/gestures/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "type": "module"
}
