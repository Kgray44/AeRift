{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeRift",
  "version": "0.1.0",
  "identifier": "com.kgamazing44.aerift",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AeRift",
        "width": 960,
        "height": 680,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-src 'none'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "aerift"
}
